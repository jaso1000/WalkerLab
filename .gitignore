# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# Claude Code local settings
.claude/settings.local.json

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# server/ build artifacts - server/dist is covered by the bare dist/ pattern
# above; server/public is the copied-in Expo web export (see Dockerfile),
# regenerated fresh on every build, not source.
/server/public

# local data dir if the backend is ever run directly from the repo root
/data

# local Expo module build artifacts (modules/*/android is source and is
# tracked; its own build/ output dir is not, same reasoning as /android above)
modules/**/android/build/
modules/**/ios/build/
